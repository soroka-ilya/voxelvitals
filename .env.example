# ==========================================
# VoxelVitals Production Environment Variables
# ==========================================

# Network binding
HOST=0.0.0.0
PORT=8000

# Persistent SQLite database storage path
# In Docker: /app/data/voxelvitals.db
# Local dev: voxelvitals.db
DB_PATH=/app/data/voxelvitals.db

# Background server telemetry polling interval (seconds)
POLL_INTERVAL_SECONDS=300

# Ping socket connection timeout (seconds)
QUERY_TIMEOUT_SECONDS=5.0

# Application environment (development | production)
APP_ENV=production

# Base application URL for OAuth redirects
BASE_URL=http://localhost:8000

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Microsoft / Xbox OAuth Credentials (from Azure Portal / Entra ID)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
